<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Eventide.App.SettingsUi.SettingsApp"
             Name="Eventide"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Eventide/Theme/Colors.axaml" />
        <ResourceInclude Source="avares://Eventide/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Accent instead of system blue: switches, radio buttons, check marks, sliders, selection, focus -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#FFB7D894"
                               RegionColor="#FF202734"
                               AltHigh="#FF202734"
                               ListLow="#FF2D3649"
                               ListMedium="#FF36415A"
                               ChromeMediumLow="#FF262F40"
                               ChromeMedium="#FF2D3649"
                               ChromeLow="#FF1B2130"
                               ChromeAltLow="#FFEEF2F7"
                               BaseHigh="#FFEEF2F7" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Eventide/Theme/Styles.axaml" />
  </Application.Styles>

</Application>
